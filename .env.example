# Django Environment Variables Configuration
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control

# Django Secret Key
# Used for cryptographic signing. Generate a secure random key for production.
# For development, you can use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug Mode
# Set to True for development, False for production
# Never use DEBUG=True in production
DEBUG=True

# Allowed Hosts
# Comma-separated list of host/domain names that this Django site can serve
# For development: localhost,127.0.0.1
# For production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL
# Format: postgres://username:password@hostname:port/database_name
# For local development with SQLite, you can leave this empty or use: sqlite:///db.sqlite3
# For production with PostgreSQL (e.g., Neon): postgres://user:password@ep-xyz.aws.neon.tech/neondb
DATABASE_URL=sqlite:///db.sqlite3

# Optional: Django Admin URL
# Change the admin URL from /admin/ to something more secure in production
# Leave empty to use default /admin/
# ADMIN_URL=admin